# Copy to .env.capacitor and set to your own PagerMonitor backend before running
# `npm run build:capacitor` / `npm run android:sync` — this gets baked into the
# Android app bundle at build time, since the app has no server of its own to
# derive it from at runtime (see frontend/src/hooks/useWebSocket.js).
VITE_BACKEND_URL=https://your-pagermonitor-domain.example
